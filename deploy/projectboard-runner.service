[Unit]
Description=ProjectBoard Runner
After=network-online.target

[Service]
Type=simple
User=projectboard
ExecStart=/usr/local/bin/projectboard-runner poll --watch
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/projectboard-runner

[Install]
WantedBy=multi-user.target
