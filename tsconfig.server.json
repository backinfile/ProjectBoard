{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts", "src/mcp/**/*.ts", "src/runner/**/*.ts", "src/ops/**/*.ts"]
}
