PORT=3333
PROJECTBOARD_DATA_DIR=./data
PROJECTBOARD_DB=./data/projectboard.db
PROJECTBOARD_BOOTSTRAP_USERNAME=admin
# Optional: generated and printed once when omitted on the first start.
# PROJECTBOARD_BOOTSTRAP_PASSWORD=
PROJECTBOARD_ENV=development
# Used by `projectboard mcp` and `projectboard-runner`.
PROJECTBOARD_URL=http://127.0.0.1:3333
# PROJECTBOARD_AGENT_TOKEN=
