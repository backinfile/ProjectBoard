PORT=3333
PROJECTBOARD_DATA_DIR=./data
PROJECTBOARD_DB=./data/projectboard.db
PROJECTBOARD_BOOTSTRAP_USERNAME=admin
# Optional: generated and printed once when omitted on the first start.
# PROJECTBOARD_BOOTSTRAP_PASSWORD=
PROJECTBOARD_ENV=development
# Public HTTPS origin used for provider callbacks and webhooks.
# PROJECTBOARD_PUBLIC_URL=https://projectboard.example.com

# GitHub App (deployment-only; the private key is never accepted from a browser).
# PROJECTBOARD_GITHUB_APP_ID=
# PROJECTBOARD_GITHUB_APP_SLUG=
# PROJECTBOARD_GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.pem
# PROJECTBOARD_GITHUB_WEBHOOK_SECRET=
# Defaults to $PROJECTBOARD_PUBLIC_URL/api/git/webhooks/github.
# PROJECTBOARD_GITHUB_WEBHOOK_URL=

# GitLab OAuth application and project webhook verification.
# PROJECTBOARD_GITLAB_CLIENT_ID=
# PROJECTBOARD_GITLAB_CLIENT_SECRET=
# PROJECTBOARD_GITLAB_BASE_URL=https://gitlab.com
# PROJECTBOARD_GITLAB_WEBHOOK_SECRET=

# Used by `projectboard mcp` and `projectboard-runner`.
PROJECTBOARD_URL=http://127.0.0.1:3333
# PROJECTBOARD_AGENT_TOKEN=
